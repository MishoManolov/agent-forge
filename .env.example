# Copy to .env (scripts/setup.sh does this). Everything here is optional except one provider key.

# Redis used for agent-to-agent messaging (docker-compose.yml publishes it on 6390)
FORGE_REDIS_URL=redis://127.0.0.1:6390/0

# --- Provider keys: set at least one (they are copied into every agent's Hermes profile) ---
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Default model for agents and for the role architect/critic, as <provider>/<model> ---
# OpenRouter:  openrouter/anthropic/claude-sonnet-4
# Anthropic:   anthropic/claude-sonnet-4
# Copilot:     copilot/gpt-4.1        (needs `hermes auth` / a gh login in Hermes)
# Codex:       openai-codex/<model>   (needs `hermes auth`)
FORGE_DEFAULT_MODEL=openrouter/anthropic/claude-sonnet-4
# Optional: a stronger model just for researching roles
# FORGE_ARCHITECT_MODEL=

# 1 = agents run without Hermes approval prompts (the destructive-command guard still applies)
# 0 = Hermes asks for approval in each pane
FORGE_YOLO=1
